# Copy to .env (same folder as config.json). Never commit .env.
# Only needed for values referenced as "env:NAME" in config.json. With Key Vault you can leave
# this file out entirely.

# --- tokens (if not using Key Vault) ---
# GitHub PAT: see README "Tokens" for scopes
OPSPULSE_GITHUB_TOKEN=
# SonarQube Cloud user token (an org/enterprise admin's token)
OPSPULSE_SONAR_TOKEN=
# Jira Cloud: API token from id.atlassian.com/manage-profile/security/api-tokens
OPSPULSE_JIRA_EMAIL=
OPSPULSE_JIRA_TOKEN=

# --- proxies (if config.json references them) ---
# OPSPULSE_PROXY_SONAR=http://user:pass@proxy.corp.example:8080
