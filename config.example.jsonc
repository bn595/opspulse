// opspulse configuration. Copy to config.json and edit. Comments are permitted.
// All settings have defaults; omit any that are not needed. Reference: README.md.
//
// Token / email / proxy values are references:
//   "keyvault:NAME"  secret NAME from the Azure Key Vault below (recommended)
//   "env:VAR"        environment variable, also read from a .env file next to this one
//   "file:path"      contents of a file
//   other            literal value (not recommended for tokens)
{
  "server": {
    "port": 4777,
    "openBrowser": true,
    "refreshMinutes": 10
  },

  // Panel order and visibility. Ids: feed, kpis, actions, jira, ghas, sonar, or a plugin id.
  "ui": {
    "panels": [],
    "hide": []
  },

  // ---------------------------------------------------------------------------
  // Network: proxy URL per platform; empty means direct. Node does not read HTTPS_PROXY.
  // For proxies that require credentials (user:pass@host), use an env: reference.
  "network": {
    "proxies": {
      "github": "",
      "sonar": "env:OPSPULSE_PROXY_SONAR",   // e.g. http://proxy.corp.example:8080
      "jira": "",
      "azure": ""                            // cannot be a keyvault: reference
    },
    // Additional PEM CA bundle, e.g. for TLS-inspecting proxies. NODE_EXTRA_CA_CERTS also works.
    "caFile": "",
    "timeoutSeconds": 30
  },

  // ---------------------------------------------------------------------------
  // Secrets: source for "keyvault:NAME" references.
  // Default secret names: github-token, sonar-token, jira-token.
  // Values are held in memory only and refreshed every cacheMinutes.
  "secrets": {
    "azureKeyVault": {
      "vaultUrl": "https://your-vault.vault.azure.net",
      // auto     Azure CLI session if available, otherwise browser sign-in
      // cli      Azure CLI session only (requires `az login`)
      // browser  organization sign-in in the browser
      // device   code entry at microsoft.com/devicelogin
      "auth": "auto",
      // Optional. Defaults to the user's home tenant and the Azure CLI's public client ID,
      // so no app registration is required. See README.
      // "tenantId": "your-tenant-id-or-domain",
      // "clientId": "your-own-app-registration-id",
      "cacheMinutes": 60
    }
  },

  // ---------------------------------------------------------------------------
  "github": {
    "apiUrl": "https://api.github.com",
    "token": "keyvault:github-token",   // or "env:OPSPULSE_GITHUB_TOKEN"

    "actions": {
      "repos": [
        {
          "repo": "your-org/sonar-permission-jobs",
          "label": "Permission jobs",
          "workflows": ["*"],
          // warn when a scheduled workflow has not run within this many hours
          "expectEveryHours": { "Nightly permission audit": 26 }
        },
        {
          "repo": "your-org/sonar-access-requests",
          "label": "Access requests",
          "workflows": ["process-request.yml", "revoke-expired.yml"],
          "branch": "main"
        }
      ],
      "lookbackHours": 168,
      "feedWindowHours": 24,
      "failureWarn": 1,
      "failureCritical": 3
    },

    "dismissals": {
      "orgs": ["your-org"],
      "lookbackDays": 30,
      "tools": ["code-scanning", "secret-scanning", "dependabot"],
      "feed": false,
      // Optional include/exclude rules (also available under github.actions and jira).
      // Fields: tool, org, repo, by, reason, title, severity, comment, secretType, validity,
      // package, ecosystem, ruleId, toolName, or any API field via "raw.<path>".
      // See README "Exclude or include data with rules".
      "exclude": [
        // { "by": "*[bot]" }
      ]
    }
  },

  "sonar": {
    "url": "https://sonarqube.us",      // EU region: https://sonarcloud.io
    "token": "keyvault:sonar-token",    // or "env:OPSPULSE_SONAR_TOKEN"
    "organizations": ["your-org"],
    "staleDays": 30,
    "tokenExpiryWarnDays": 14
  },

  "jira": {
    "deployment": "cloud",              // cloud | datacenter
    "baseUrl": "https://your-company.atlassian.net",
    "email": "you@your-company.com",    // Cloud only; or "keyvault:jira-email"
    "token": "keyvault:jira-token",     // or "env:OPSPULSE_JIRA_TOKEN"
    "jql": "project = ITRK AND (statusCategory != Done OR resolved >= -30d) ORDER BY created DESC",
    "lookbackDays": 30,
    "staleDays": 7,
    "newWindowHours": 24,
    "statusRules": [
      { "status": "Blocked", "olderThanDays": 3, "level": "warn" },
      { "status": "Triage", "olderThanHours": 48, "level": "warn" }
    ]
  },

  // ---------------------------------------------------------------------------
  // Plugins: your own panels. Keys other than path/id/title/enabled are passed as ctx.options.
  // See README "Plugins" and plugins/examples/runs-by-actor.js.
  "plugins": [
    // { "path": "./plugins/examples/runs-by-actor.js", "days": 7, "failureWarn": 3 }
  ]
}
